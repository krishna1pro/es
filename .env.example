# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Google Sheets Integration (for Public Voice)
# Create a Google Service Account in Google Cloud Console
# Share your spreadsheet with the service account email
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=

# MongoDB Atlas Database Configuration (Single source of truth for CMS)
# Recommended Option A: Discrete variables
MONGODB_CLUSTER_HOST="cluster0.lqdmdvr.mongodb.net"
MONGODB_USERNAME=""
MONGODB_PASSWORD=""
MONGODB_DB_NAME="chintadaravikumar"

# Alternative Option B: Unified connection URI
# MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.lqdmdvr.mongodb.net/chintadaravikumar?retryWrites=true&w=majority"

# Isolated Acceptance Test Database (Phase 4E.3.1 Acceptance Testing)
# Scoped strictly to chintadaravikumar_test with restricted permissions
# MONGODB_TEST_URI="mongodb+srv://<test_username>:<test_password>@cluster0.lqdmdvr.mongodb.net/chintadaravikumar_test?retryWrites=true&w=majority"
# MONGODB_TEST_DB_NAME="chintadaravikumar_test"

# Super Admin Authorization Allowlist (Server-Side)
# Configure your trusted Google email address via Secrets panel.
# Multiple emails can be separated by commas (e.g., "leader@gmail.com,admin@example.com").
# If unset or empty, the system fails closed: no user is granted Super Admin privileges.
SUPER_ADMIN_EMAILS="your-admin-account@gmail.com"
