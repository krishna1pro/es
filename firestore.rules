rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- Helper Functions ---
    
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isSuperAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'krishnapro216@gmail.com'
      );
    }
    
    function incoming() {
      return request.resource.data;
    }
    
    function existing() {
      return resource.data;
    }

    // --- Validation Helpers ---

    function isValidGrievance(data) {
      return data.keys().hasAll(['category', 'subject', 'description', 'status', 'trackingNumber', 'createdAt']) &&
             data.subject is string && data.subject.size() <= 256 &&
             data.description is string && data.description.size() <= 5000 &&
             data.status == 'SUBMITTED';
    }

    function isValidArticle(data) {
      return data.keys().hasAll(['type', 'title', 'content', 'status']) &&
             data.title is string && data.title.size() <= 256 &&
             data.content is string && data.content.size() <= 100000 &&
             data.status in ['DRAFT', 'PUBLISHED', 'ARCHIVED'];
    }

    // --- Restrictive Collection Rules ---

    // Deny all unauthenticated or undeclared collection access by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Users: Users may only read their own profile; no unauthenticated reads or role self-elevation
    match /users/{userId} {
      allow get: if isSignedIn() && request.auth.uid == userId;
      allow list: if isSuperAdmin();
      allow create: if isSignedIn() && request.auth.uid == userId && 
                       incoming().status == 'PENDING' && 
                       incoming().role == 'VIEWER';
      allow update, delete: if isSuperAdmin();
    }

    // Roles: Super Admin only
    match /roles/{roleId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    // Pages: Read-only for public; write restricted to Super Admin
    match /pages/{pageId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // Media: Read-only for public; write restricted to Super Admin
    match /media/{mediaId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // Articles: Public reads published articles only; writes/deletes require Super Admin
    match /articles/{articleId} {
      allow read: if resource.data.status == 'PUBLISHED' || isSuperAdmin();
      allow create, update: if isSuperAdmin() && isValidArticle(incoming());
      allow delete: if isSuperAdmin();
    }

    // Volunteers: Authenticated users can submit volunteer applications for themselves
    match /volunteers/{userId} {
      allow read: if isSuperAdmin() || (isSignedIn() && request.auth.uid == userId);
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update, delete: if isSuperAdmin();
    }

    // Grievances: Public can create with valid schema; only Super Admin can list, read, or update
    match /grievances/{grievanceId} {
      allow create: if isValidGrievance(incoming());
      allow read, update: if isSuperAdmin();
      allow delete: if false;
    }

    // Analytics: Events can be created; reading restricted to Super Admin
    match /analytics_events/{eventId} {
      allow create: if true;
      allow read: if isSuperAdmin();
      allow update, delete: if false;
    }

    // Audit logs: Client access completely disabled (audit logging is MongoDB Atlas authoritative)
    match /audit_logs/{logId} {
      allow read, write: if false;
    }

    // Config: Super Admin only
    match /config/{configId} {
      allow read, write: if isSuperAdmin();
    }
  }
}
